          "standard_set_allowed": true,
          "hard_test_only": false,
          "required_inputs": [
            "train_metric",
            "validation_metric",
            "metric_direction",
            "validation_curve"
          ],
          "required_features": [
            "relative_generalization_gap",
            "late_degradation"
          ],
          "required_flags": [],
          "ground_truth_strategy": "Use the existing diagnosis pipeline. Require a strong relative generalization gap together with late validation degradation.",
