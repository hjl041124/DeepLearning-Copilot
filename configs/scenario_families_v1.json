    "standard_split_unit": "template_family_id",
    "scenario_family_may_span_standard_splits": true,
    "unseen_scenario_family_reserved_for_hard_test": true,
    "standard_set_single_primary_issue": true,
    "standard_set_excludes_borderline_cases": true,
    "ground_truth_must_be_deterministic_python": true,
    "sampling_policy": "balance_task_type_then_primary_issue_then_scenario_family"
